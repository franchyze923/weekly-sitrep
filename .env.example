# --- local development ---
AUTH_MODE=dev
DEV_USER_EMAIL=fran@example.com
DEV_USER_NAME="Fran"
DATABASE_URL=sqlite:///./data/sitrep.db
APP_TZ=America/New_York
SEED_PROJECTS="Project A,Project B"
# FAKE_TODAY=2026-11-02   # dev mode only: pretend it is this date to test week rollover

# --- real login page (locally or in Kubernetes) ---
# AUTH_MODE=login
# SESSION_SECRET=<openssl rand -hex 32>
# SESSION_SECURE=false   # only for local http://localhost testing; never in the cluster
# Built-in users: python -m app.users add you@example.com --name "You"
# Optional "Log in with Keycloak" button; leave all three unset to have local accounts only.
# OIDC_DISCOVERY_URL=https://keycloak.franpolignano.com/realms/homelab/.well-known/openid-configuration
# OIDC_CLIENT_ID=weekly-sitrep
# OIDC_CLIENT_SECRET=<from Keycloak client credentials>
# OIDC_PROVIDER_NAME=Keycloak
# DATABASE_URL=sqlite:////data/sitrep.db
